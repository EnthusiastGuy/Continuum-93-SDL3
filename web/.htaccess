# Apache (most shared hosting). Continuum 93 runs WebAssembly threads, which browsers allow only on
# cross-origin isolated pages: these two headers. Needs mod_headers; without it, coi-sw.js steps in.
<IfModule mod_headers.c>
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Embedder-Policy "require-corp"
</IfModule>
AddType application/wasm .wasm
AddType application/octet-stream .data
