  f# = CHR$("a b", PEEK32(a)) >= PEEK32(MIN(-32, NOT arr)) + 1 IMPLY f# OR TAN(f# NOR (VARPTR(n)), X, -RTRIM() > TIME) = --3.0 + "hi" OR "x\ny" < "a b"
