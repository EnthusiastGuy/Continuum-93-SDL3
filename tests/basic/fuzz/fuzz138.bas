    PLOT VARPTR(i), g# SHR (PEEK24(NOT RND(LEN(--7, NOT (ABS()), -(g#[10])), "", x) XNOR TIME ROR PEEK24(a)))
 THEN WEND
  POKE32 (TICKS), NOT (PEEK16("a b" MOD t$[(x)]) =] -31 <= MAX(-7, g#) OR n OR 1) NAND VARPTR(n)
  MEMCOPY MOUSE X XNOR "x\ny", 0, (n < TRIM((NOT n MOD b) NAND PEEK(VARPTR(Y)) <= ("x\ny"), COS(STRING(LTRIM(), (LEN(ASC())), NOT 255) SHR MID$((RIGHT(VARPTR(x))), (65535), STRING(0, POW(ASC("", RIGHT(3.0, 2), 1)), MID$(MOUSE Y, (VARPTR(X)), (31)))), (ROUND(2) OR x))))
  MEMFILL (TIME) * "x\ny" SHL arr <= y \ (y) AND 0 MOD MOUSE Y, -(NOT f# * "x\ny" SHL ("a b") AND PEEK32(1.5) SHL VAL(b)) * i, 0
