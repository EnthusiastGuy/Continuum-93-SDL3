  LINE FLOOR(), (LEFT(PEEK24(NOT -7 >= 0) <> 32)), 10, (VARPTR(arr) >= foo(-7 ROL "" XOR (b AND -2.5), arr = 10 OR (INKEY $), (PEEK16(LCASE(10, 31))) IMPLY f# < PEEK24(arr))), Y
  REM x
