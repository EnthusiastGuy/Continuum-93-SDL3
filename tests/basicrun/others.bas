' D-18: LEFT$ RIGHT$ MID$ LEN CHR$ ASC VAL STR$, also inside wider expressions
s$ = "Hello World"
a$ = LEFT(s$, 5)
b$ = RIGHT(s$, 5)
c$ = MID(s$, 7, 3)
d$ = MID(s$, 3)
e$ = LEFT(s$, 0)
f$ = LEFT("abc", 10)
g$ = RIGHT("abc", 5)
h$ = RIGHT("abc", 0)
i$ = MID("Hello", 9)
j$ = MID("Hello", 0, 2)
k$ = MID("Hello", 2, -1)
l = LEN(s$)
m = LEN("")
n = 3 * LEN(a$) + LEN(b$)
o$ = CHR(65)
p = ASC("A")
q = ASC("")
r = VAL("-1234")
u = VAL("42abc")
v = VAL("x")
w$ = STR(l * 3)
z$ = STR(-5)
' expect a$ = "Hello"
' expect b$ = "World"
' expect c$ = "Wor"
' expect d$ = "llo World"
' expect e$ = ""
' expect f$ = "abc"
' expect g$ = "abc"
' expect h$ = ""
' expect i$ = ""
' expect j$ = "He"
' expect k$ = "ello"
' expect l = 11
' expect m = 0
' expect n = 20
' expect o$ = "A"
' expect p = 65
' expect q = 0
' expect r = -1234
' expect u = 42
' expect v = 0
' expect w$ = "33"
' expect z$ = "-5"
