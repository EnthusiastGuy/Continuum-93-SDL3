# Raspberry Pi 3, Zero 2 W, 4, 400, 5 (one arm64 kernel8.img): on top of the Pi kernel's bcm2711_defconfig with
# every module dropped (mod2noconfig) and kernel.config. The defconfig brings the SoC glue (clocks, firmware
# mailbox, power domains, PCIe and RP1 for the Pi 4/5's USB, SD controllers), so only what it leaves as modules is here.

# Boot: the firmware loads kernel8.img (gzip: it unpacks it) with the initramfs inside; cmdline.txt is the command line.
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# No network, Wi-Fi or Bluetooth: the emulator needs none, and they are most of the defconfig.
# CONFIG_NET is not set
# The firmware's own framebuffer driver: vc4 drives the screen instead.
# CONFIG_FB_BCM2708 is not set
# Server and desktop features of the defconfig: virtualisation, tracing and debugging, containers, security
# modules, disk filesystems other than FAT, RAID, loop and RAM disks, swap, USB gadget mode, 32-bit programs.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_SECURITY is not set
# CONFIG_EXT4_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_SWAP is not set
# CONFIG_USB_GADGET is not set
# CONFIG_COMPAT is not set
# CONFIG_NUMA is not set

# Display: vc4 KMS (dtoverlay=vc4-kms-v3d), HDMI at the monitor's own mode; I2C reads the monitor's EDID.
CONFIG_DRM_VC4=y
CONFIG_I2C_BCM2835=y
CONFIG_I2C_BRCMSTB=y

# Sound: HDMI through vc4 (ASoC), the 3.5 mm jack (Pi 3/4) through the VideoCore (VCHIQ).
CONFIG_SND_SOC=y
CONFIG_SND_BCM2835=y
