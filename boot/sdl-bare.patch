+#ifndef SDL_USE_LIBUDEV
+/* No udev: scan /dev/input like the joystick fallback does, again whenever the directory
+   changes (devtmpfs updates its mtime on hotplug), and guess each device's class ourselves. */
+static void SDL_EVDEV_scan(void)
+{
+    static struct timespec last_mtime;
+    struct stat st;
+    SDL_evdevlist_item *item, *next;
+    struct dirent *entry;
+    DIR *dir;
+
+    if (stat("/dev/input", &st) < 0 ||
+        (st.st_mtim.tv_sec == last_mtime.tv_sec && st.st_mtim.tv_nsec == last_mtime.tv_nsec)) {
+        return;
+    }
+    last_mtime = st.st_mtim;
+
+    for (item = _this->first; item; item = next) {
+        next = item->next;
+        if (access(item->path, F_OK) < 0) {
+            char path[PATH_MAX];
+            SDL_strlcpy(path, item->path, sizeof(path)); // removal frees item->path
+            SDL_EVDEV_device_removed(path);
+        }
+    }
+
+    dir = opendir("/dev/input");
+    if (!dir) {
+        return;
+    }
+    while ((entry = readdir(dir)) != NULL) {
+        unsigned long props[NBITS(INPUT_PROP_MAX)] = { 0 };
+        unsigned long ev[NBITS(EV_MAX)] = { 0 };
+        unsigned long abs[NBITS(ABS_MAX)] = { 0 };
+        unsigned long keys[NBITS(KEY_MAX)] = { 0 };
+        unsigned long rel[NBITS(REL_MAX)] = { 0 };
+        char path[PATH_MAX];
+        int fd, devclass;
+
+        if (SDL_strncmp(entry->d_name, "event", 5) != 0) {
+            continue;
+        }
+        (void)SDL_snprintf(path, sizeof(path), "/dev/input/%s", entry->d_name);
+        for (item = _this->first; item && SDL_strcmp(item->path, path) != 0; item = item->next) {
+        }
+        if (item) {
+            continue; // already open
+        }
+        fd = open(path, O_RDONLY | O_CLOEXEC);
+        if (fd < 0) {
+            continue;
+        }
+        ioctl(fd, EVIOCGPROP(sizeof(props)), props);
+        ioctl(fd, EVIOCGBIT(0, sizeof(ev)), ev);
+        ioctl(fd, EVIOCGBIT(EV_ABS, sizeof(abs)), abs);
+        ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(keys)), keys);
+        ioctl(fd, EVIOCGBIT(EV_REL, sizeof(rel)), rel);
+        close(fd);
+        devclass = SDL_EVDEV_GuessDeviceClass(props, ev, abs, keys, rel);
+        if (devclass & (SDL_UDEV_DEVICE_MOUSE | SDL_UDEV_DEVICE_KEYBOARD | SDL_UDEV_DEVICE_TOUCHSCREEN | SDL_UDEV_DEVICE_TOUCHPAD)) {
+            SDL_EVDEV_device_added(path, devclass);
+        }
+    }
+    closedir(dir);
+}
+#endif // !SDL_USE_LIBUDEV
