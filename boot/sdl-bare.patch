+/* Dumb-buffer mode: with no libgbm (no Mesa), SDL renders in software into mapped DRM dumb buffers.
+   Two of them, page-flipped at vblank: KMS drivers (vc4) scan a buffer out as it is drawn, so drawing
+   into the shown one flickers (each frame starts with a clear). Drivers without page flips get one
+   buffer and DIRTYFB, which suits firmware framebuffers (simpledrm copies on DIRTYFB anyway). */
+static void KMSDRM_GetModeToSet(SDL_Window *window, drmModeModeInfo *out_mode);
+
+static void KMSDRM_DestroyWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_WindowData *windata = window->internal;
+    int fd = _this->internal->drm_fd;
+    int i;
+
+    if (!windata) {
+        return;
+    }
+    for (i = 0; i < 2; ++i) {
+        if (windata->dumb_map[i]) {
+            munmap(windata->dumb_map[i], windata->dumb_size);
+            windata->dumb_map[i] = NULL;
+        }
+        if (windata->dumb_fb[i]) {
+            KMSDRM_drmModeRmFB(fd, windata->dumb_fb[i]);
+            windata->dumb_fb[i] = 0;
+        }
+        if (windata->dumb_handle[i]) {
+            struct drm_mode_destroy_dumb destroy = { windata->dumb_handle[i] };
+            ioctl(fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroy);
+            windata->dumb_handle[i] = 0;
+        }
+    }
+}
+
+static bool KMSDRM_CreateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, SDL_PixelFormat *format, void **pixels, int *pitch)
+{
+    SDL_WindowData *windata = window->internal;
+    SDL_DisplayData *dispdata = SDL_GetDisplayDriverDataForWindow(window);
+    int fd = _this->internal->drm_fd;
+    struct drm_mode_create_dumb create;
+    struct drm_mode_map_dumb map;
+    void *mapped;
+    int w, h, i;
+
+    KMSDRM_DestroyWindowFramebuffer(_this, window);
+    KMSDRM_GetModeToSet(window, &dispdata->mode);
+
+    // SDL sizes the surface from the window: never let it outgrow the buffer.
+    SDL_GetWindowSizeInPixels(window, &w, &h);
+    for (i = 0; i < 2; ++i) {
+        SDL_zero(create);
+        create.width = SDL_max(w, dispdata->mode.hdisplay);
+        create.height = SDL_max(h, dispdata->mode.vdisplay);
+        create.bpp = 32;
+        if (ioctl(fd, DRM_IOCTL_MODE_CREATE_DUMB, &create) < 0) {
+            SDL_SetError("KMSDRM: cannot create a dumb buffer: %s", strerror(errno));
+            KMSDRM_DestroyWindowFramebuffer(_this, window);
+            return false;
+        }
+        windata->dumb_handle[i] = create.handle;
+        windata->dumb_size = (size_t)create.size;
+
+        SDL_zero(map);
+        map.handle = create.handle;
+        if (KMSDRM_drmModeAddFB(fd, create.width, create.height, 24, 32, create.pitch, create.handle, &windata->dumb_fb[i]) ||
+            ioctl(fd, DRM_IOCTL_MODE_MAP_DUMB, &map) < 0 ||
+            (mapped = mmap(NULL, windata->dumb_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, map.offset)) == MAP_FAILED) {
+            SDL_SetError("KMSDRM: cannot map the dumb buffer: %s", strerror(errno));
+            KMSDRM_DestroyWindowFramebuffer(_this, window);
+            return false;
+        }
+        windata->dumb_map[i] = mapped;
+        SDL_memset(mapped, 0, windata->dumb_size);
+    }
+
+    if (KMSDRM_drmModeSetCrtc(fd, dispdata->crtc.crtc->crtc_id, windata->dumb_fb[0], 0, 0,
+                              &dispdata->connector.connector->connector_id, 1, &dispdata->mode)) {
+        SDL_SetError("KMSDRM: cannot show the dumb buffer: %s", strerror(errno));
+        KMSDRM_DestroyWindowFramebuffer(_this, window);
+        return false;
+    }
+    windata->dumb_back = 1;
+    windata->dumb_flip = true;
+    SDL_Log("KMSDRM: %dx%d dumb buffers, page-flipped at vblank", dispdata->mode.hdisplay, dispdata->mode.vdisplay);
+
+    *format = SDL_PIXELFORMAT_XRGB8888;
+    *pixels = windata->dumb_map[1];
+    *pitch = (int)create.pitch;
+    return true;
+}
+
+static bool KMSDRM_UpdateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, const SDL_Rect *rects, int numrects)
+{
+    SDL_WindowData *windata = window->internal;
+    SDL_DisplayData *dispdata = SDL_GetDisplayDriverDataForWindow(window);
+    int fd = _this->internal->drm_fd;
+    struct drm_mode_fb_dirty_cmd dirty;
+
+    if (windata->dumb_flip) {
+        // Show the finished frame at the next vblank, then draw into the buffer that was on screen.
+        windata->waiting_for_flip = true;
+        if (KMSDRM_drmModePageFlip(fd, dispdata->crtc.crtc->crtc_id, windata->dumb_fb[windata->dumb_back],
+                                   DRM_MODE_PAGE_FLIP_EVENT, &windata->waiting_for_flip) == 0) {
+            KMSDRM_WaitPageflip(_this, windata);
+            windata->dumb_back ^= 1;
+            window->surface->pixels = windata->dumb_map[windata->dumb_back];
+            return true;
+        }
+        windata->waiting_for_flip = false;
+        // No page flips: show the buffer SDL draws into and keep it.
+        windata->dumb_flip = false;
+        SDL_Log("KMSDRM: no page flips (%s); one buffer, drawn on screen", strerror(errno));
+        KMSDRM_drmModeSetCrtc(fd, dispdata->crtc.crtc->crtc_id, windata->dumb_fb[windata->dumb_back], 0, 0,
+                              &dispdata->connector.connector->connector_id, 1, &dispdata->mode);
+    }
+    // Drivers that copy to the real framebuffer (simpledrm) need to hear what changed; the rest ignore it.
+    SDL_zero(dirty);
+    dirty.fb_id = windata->dumb_fb[windata->dumb_back];
+    ioctl(fd, DRM_IOCTL_MODE_DIRTYFB, &dirty);
+    return true;
+}
