# Boot image kernel, every platform: this plus kernel-pc.config (on tinyconfig) or kernel-rpi.config (on the
# Raspberry Pi defconfig). Everything built in (no modules); boot/build.sh fails if Kconfig drops any of them.

# What glibc, busybox, SDL and ALSA (dmix: SysV semaphores) call.
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FILE_LOCKING=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Display: KMS (SDL draws into dumb buffers), the console on it until the emulator starts.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# USB storage (and UAS), FAT/exFAT sticks and SD cards.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_BLOCK=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Input: USB keyboards and mice, gamepads (generic HID, Xbox, PlayStation, Switch).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MICROSOFT=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_SONY=y
CONFIG_HID_NINTENDO=y

# Sound: ALSA and USB audio (the machine's own sound chip is in the platform fragment).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
