# Boot image kernel: `make tinyconfig` plus these. Everything built in (no modules, no firmware files);
# boot/build.sh fails if Kconfig drops any of them. One section per thing the emulator needs.

# Boot: the kernel is its own EFI loader; initramfs inside, compressed once with the kernel.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_KERNEL_ZSTD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_CMDLINE_BOOL=y
# delay_use=0: mount the stick without usb-storage's 1 s settle; dsp_driver=1: plain HDA on Intel DSP laptops;
# efifb:auto: the EFI stub switches to the largest GOP mode (the panel's native one) instead of the boot default.
CONFIG_CMDLINE="quiet loglevel=3 usb-storage.delay_use=0 snd_intel_dspcfg.dsp_driver=1 video=efifb:auto"
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# What glibc, busybox, SDL and ALSA (dmix: SysV semaphores) call.
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FILE_LOCKING=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Machine: all cores (CPU thread + host loop), ACPI for power off, the wall clock for the guest.
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HPET_TIMER=y
CONFIG_X86_PAT=y
CONFIG_MTRR=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# Display: the firmware's framebuffer (UEFI GOP or VESA) through simpledrm; SDL draws into dumb buffers.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# USB: every host controller generation, storage (and UAS), HID.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_BLOCK=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Input: USB and PS/2 keyboards and mice (laptops too), gamepads (generic HID, Xbox, PlayStation, Switch).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MICROSOFT=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_SONY=y
CONFIG_HID_NINTENDO=y

# Sound: Intel HDA (most PCs since 2005) with the common codecs, AC'97 (older PCs), USB audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
